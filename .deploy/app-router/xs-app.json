{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "logout": { "logoutEndpoint": "/do/logout", "logoutPage": "/" },
  "routes": [
    {
      "source": "^/-/cds/.*",
      "destination": "mtx-api",
      "authenticationType": "none"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    }
  ]
}
