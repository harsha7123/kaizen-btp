<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".DroidXApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.DroidX">

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.DroidX.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.QuestionnaireActivity"
            android:exported="false"
            android:theme="@style/Theme.DroidX.NoActionBar" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.DroidX.NoActionBar" />

        <activity
            android:name=".ui.DashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.DroidX.NoActionBar" />

        <activity
            android:name=".ui.NewInspectionActivity"
            android:exported="false"
            android:theme="@style/Theme.DroidX.NoActionBar" />

        <activity
            android:name=".ui.InspectionDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.DroidX.NoActionBar" />

        <activity
            android:name=".ui.DeliveryListActivity"
            android:exported="false"
            android:theme="@style/Theme.DroidX.NoActionBar" />

        <activity
            android:name=".ui.DeliveryFormActivity"
            android:exported="false"
            android:theme="@style/Theme.DroidX.NoActionBar" />

        <activity
            android:name=".ui.RFMenuActivity"
            android:exported="false"
            android:theme="@style/Theme.DroidX.NoActionBar" />

        <activity
            android:name=".ui.RFSubMenuActivity"
            android:exported="false"
            android:theme="@style/Theme.DroidX.NoActionBar" />

        <activity
            android:name=".ui.LabelActivity"
            android:exported="false"
            android:theme="@style/Theme.DroidX.NoActionBar" />

        <activity
            android:name=".ui.ReportActivity"
            android:exported="false"
            android:theme="@style/Theme.DroidX.NoActionBar" />

        <activity
            android:name=".ui.PackingActivity"
            android:exported="false"
            android:theme="@style/Theme.DroidX.NoActionBar" />

        <activity
            android:name=".ui.ProductionActivity"
            android:exported="false"
            android:theme="@style/Theme.DroidX.NoActionBar" />

        <activity
            android:name=".ui.QcActivity"
            android:exported="false"
            android:theme="@style/Theme.DroidX.NoActionBar" />

        <activity
            android:name=".ui.VoiceGrActivity"
            android:exported="false"
            android:theme="@style/Theme.DroidX.NoActionBar" />

        <activity
            android:name=".ui.ConfirmTaskActivity"
            android:exported="false"
            android:theme="@style/Theme.DroidX.NoActionBar" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- SAP BTP SDK OAuth2 redirect receiver.
             redirectUrl in MobileServices must be: com.sap.forkqa://oauth -->
        <activity
            android:name="com.sap.cloud.mobile.foundation.authentication.OAuth2RedirectActivity"
            android:exported="true"
            tools:replace="android:exported"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.sap.forkqa" android:host="oauth" />
            </intent-filter>
        </activity>

    </application>
</manifest>
