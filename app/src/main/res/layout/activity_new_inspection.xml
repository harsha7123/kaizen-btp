<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="80dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1565C0"
                android:padding="20dp"
                android:paddingBottom="28dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forklift Inspection"
                    android:textColor="#BBDEFB"
                    android:textSize="12sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pre-Operation Inspection"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Basic Info card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="-12dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Basic Information"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#1565C0"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilForkliftId"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Forklift ID *"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etForkliftId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilOperatorName"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Operator Name *"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etOperatorName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilOdometer"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Odometer Reading"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etOdometer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shift"
                        android:textColor="#555555"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp" />

                    <RadioGroup
                        android:id="@+id/rgShift"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <RadioButton
                            android:id="@+id/rbDay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Day"
                            android:checked="true"
                            android:layout_marginEnd="32dp" />
                        <RadioButton
                            android:id="@+id/rbNight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Night" />
                    </RadioGroup>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Inspection Checks card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inspection Checks"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#1565C0"
                        android:layout_marginBottom="14dp" />

                    <!-- Tire Pressure -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="1. Tire Pressure"
                            android:textSize="13sp" />
                        <RadioGroup android:id="@+id/rgTires" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:orientation="horizontal">
                            <RadioButton android:id="@+id/rbTiresPass" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="PASS"
                                android:textColor="#2E7D32" android:checked="true"
                                android:layout_marginEnd="8dp" />
                            <RadioButton android:id="@+id/rbTiresFail" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="FAIL"
                                android:textColor="#C62828" />
                        </RadioGroup>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F0F0" android:layout_marginBottom="12dp" />

                    <!-- Physical Condition -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="2. Physical Condition"
                            android:textSize="13sp" />
                        <RadioGroup android:id="@+id/rgBody" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:orientation="horizontal">
                            <RadioButton android:id="@+id/rbBodyPass" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="PASS"
                                android:textColor="#2E7D32" android:checked="true"
                                android:layout_marginEnd="8dp" />
                            <RadioButton android:id="@+id/rbBodyFail" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="FAIL"
                                android:textColor="#C62828" />
                        </RadioGroup>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F0F0" android:layout_marginBottom="12dp" />

                    <!-- Brakes -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="3. Brakes"
                            android:textSize="13sp" />
                        <RadioGroup android:id="@+id/rgBrakes" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:orientation="horizontal">
                            <RadioButton android:id="@+id/rbBrakesPass" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="PASS"
                                android:textColor="#2E7D32" android:checked="true"
                                android:layout_marginEnd="8dp" />
                            <RadioButton android:id="@+id/rbBrakesFail" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="FAIL"
                                android:textColor="#C62828" />
                        </RadioGroup>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F0F0" android:layout_marginBottom="12dp" />

                    <!-- Hydraulics -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="4. Hydraulics / Forks"
                            android:textSize="13sp" />
                        <RadioGroup android:id="@+id/rgHydraulics" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:orientation="horizontal">
                            <RadioButton android:id="@+id/rbHydraulicsPass" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="PASS"
                                android:textColor="#2E7D32" android:checked="true"
                                android:layout_marginEnd="8dp" />
                            <RadioButton android:id="@+id/rbHydraulicsFail" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="FAIL"
                                android:textColor="#C62828" />
                        </RadioGroup>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F0F0" android:layout_marginBottom="12dp" />

                    <!-- Horn & Lights -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="5. Horn &amp; Lights"
                            android:textSize="13sp" />
                        <RadioGroup android:id="@+id/rgHorn" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:orientation="horizontal">
                            <RadioButton android:id="@+id/rbHornPass" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="PASS"
                                android:textColor="#2E7D32" android:checked="true"
                                android:layout_marginEnd="8dp" />
                            <RadioButton android:id="@+id/rbHornFail" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="FAIL"
                                android:textColor="#C62828" />
                        </RadioGroup>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Remarks + Photo + Submit card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRemarks"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Remarks (optional)"
                        android:layout_marginBottom="14dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRemarks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTakePhoto"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Take Photo (optional)"
                        android:layout_marginBottom="10dp" />

                    <ImageView
                        android:id="@+id/imgPhotoPreview"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:scaleType="centerCrop"
                        android:background="#12000000"
                        android:visibility="gone"
                        android:contentDescription="Photo preview"
                        android:layout_marginBottom="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubmit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#1565C0"
                        android:text="Submit Inspection" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationContentDescription="Back" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
