<?xml version="1.0" encoding="utf-8"?>
<!-- UPS-style Shipping Label -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Brown UPS header -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#351C15" android:padding="10dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="UPS®"
            android:textColor="#FFB500" android:textSize="22sp" android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"/>
        <TextView android:id="@+id/upsService"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="UPS GROUND"
            android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Gold accent bar -->
    <View android:layout_width="match_parent" android:layout_height="4dp"
        android:background="#FFB500"/>

    <!-- Tracking number -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#FFF8E1" android:padding="8dp" android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="TRACKING: " android:textSize="11sp" android:textColor="#4E342E"
            android:textStyle="bold" android:fontFamily="monospace"/>
        <TextView android:id="@+id/upsTracking"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="13sp" android:textStyle="bold" android:fontFamily="monospace"
            android:textColor="#351C15"/>
    </LinearLayout>

    <!-- FROM / TO -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SHIP FROM:" android:textSize="10sp" android:textColor="#4E342E"
                android:textStyle="bold" android:fontFamily="monospace"/>
            <TextView android:id="@+id/upsFrom"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:fontFamily="monospace" android:textColor="#1A1A1A"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SHIP TO:" android:textSize="10sp" android:textColor="#4E342E"
                android:textStyle="bold" android:fontFamily="monospace"/>
            <TextView android:id="@+id/upsTo"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:fontFamily="monospace" android:textColor="#1A1A1A"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Reference -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#FFF8E1" android:padding="8dp" android:orientation="horizontal">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="REFERENCE / DEL #: " android:textSize="10sp" android:textColor="#4E342E"
            android:fontFamily="monospace"/>
        <TextView android:id="@+id/upsDelivery"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="10sp" android:fontFamily="monospace" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Barcode -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="10dp" android:gravity="center_horizontal">
        <ImageView android:id="@+id/upsBarcode"
            android:layout_width="match_parent" android:layout_height="70dp"
            android:scaleType="fitXY" android:contentDescription="UPS barcode"/>
        <TextView android:id="@+id/upsTrackingNum"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:fontFamily="monospace" android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Brown footer -->
    <View android:layout_width="match_parent" android:layout_height="6dp"
        android:background="#351C15"/>

</LinearLayout>
