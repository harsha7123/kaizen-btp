<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DroidX" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
    </style>

    <style name="Theme.DroidX.NoActionBar" parent="Theme.DroidX">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- System splash screen theme (API 31+): matches our blue branded screen
         so there is no white flash before SplashActivity renders. -->
    <style name="Theme.DroidX.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand_primary</item>
        <item name="postSplashScreenTheme">@style/Theme.DroidX.NoActionBar</item>
    </style>
</resources>
